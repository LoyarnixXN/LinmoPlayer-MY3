{
  "name": "@linmo/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Linmo Player Windows desktop shell.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:renderer": "esbuild src/app.js --bundle --format=iife --platform=browser --outfile=renderer/app.js",
    "build:core": "npm run build:renderer",
    "pack": "npm run build:renderer && electron-builder --dir --win --x64",
    "build": "npm run build:renderer && electron-builder --win --x64"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
